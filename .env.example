# -----------------------------------------------
# NYC Taxi Analytics Pipeline - Environment Config
# Copy this file to .env and fill in your values
# Never commit your actual .env file to GitHub
# -----------------------------------------------

# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# S3 Configuration
S3_BUCKET_NAME=your-bucket-name-here
S3_RAW_PREFIX=raw/yellow_taxi/
S3_PROCESSED_PREFIX=processed/

# Athena Configuration
ATHENA_DATABASE=nyc_taxi_db
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-bucket-name-here/athena-results/

# Glue Configuration
GLUE_DATABASE=nyc_taxi_db
GLUE_IAM_ROLE=arn:aws:iam::YOUR_ACCOUNT_ID:role/nyc-taxi-glue-role

# Date Range
START_YEAR=2024
START_MONTH=1
END_YEAR=2026
END_MONTH=3